{
  "name": "jobtrack",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:fe": "npm run dev --workspace=frontend",
    "dev:be": "npm run dev --workspace=backend",
    "dev": "npm run dev:fe",
    "build:fe": "npm run build --workspace=frontend",
    "build:be": "npm run build --workspace=backend",
    "build": "npm run build:be && npm run build:fe",
    "seed:companies": "npm run seed:companies --workspace=backend"
  },
  "devDependencies": {
    "csv-parse": "^7.0.2",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "google-auth-library": "^11.1.0"
  }
}
