{
  "manifest_version": 3,
  "name": "JobTrack Web Clipper",
  "version": "1.0.0",
  "description": "Simpan lowongan kerja dari LinkedIn, Glints, Jobstreet, dan portal karir langsung ke aplikasi JobTrack.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simpan ke JobTrack"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
