# ─── Environment Variables Template for Backend ───
PORT=3000
NODE_ENV=production

# Database (Diisi otomatis oleh docker-compose jika memakai Docker, atau isi manual jika PostgreSQL standalone)
DATABASE_URL=postgresql://jobtrack:GANTI_PASSWORD_DB_INI@postgres:5432/jobtrack_prod

# JWT Authentication (Ganti dengan string random yang panjang dan aman)
JWT_SECRET=GANTI_DENGAN_RANDOM_SECRET_KEY_MIN_32_KARAKTER
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=GANTI_DENGAN_RANDOM_REFRESH_KEY_MIN_32_KARAKTER
JWT_REFRESH_EXPIRES_IN=30d

# URL Domain Frontend (URL publik VPS/Domain Anda, misal: http://ip-vps atau https://domainanda.com)
CLIENT_URL=http://localhost

# Email SMTP Notification (Opsional: untuk reset password / verifikasi email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailanda@gmail.com
SMTP_PASS=app_password_anda
SMTP_FROM="JobTrackId <noreply@jobtrack.id>"

# Google Calendar Integration (Opsional: jika menggunakan sinkronisasi agenda ke Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/v1/integrations/google/callback
