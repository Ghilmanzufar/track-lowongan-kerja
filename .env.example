# Backend environment variables
# Copy this file to backend/.env and fill in the values

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/jobtrack_dev"
PORT=3000

# Generate secret acak panjang minimal 64 karakter, contoh:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="ganti-dengan-string-acak-minimal-64-karakter"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="ganti-dengan-string-acak-lain-minimal-64-karakter"
JWT_REFRESH_EXPIRES_IN="7d"

CLIENT_URL="http://localhost:5173"

# Konfigurasi SMTP (gunakan Gmail App Password, bukan password utama akun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email-anda@gmail.com
SMTP_PASS=app-password-16-karakter-dari-google
SMTP_FROM="JobTrack <email-anda@gmail.com>"
